# ==============================================================================
# LLM Router - Environment Configuration
# ==============================================================================

# Master API Key for accessing this router (Claude Desktop / Claude Code will use this)
MASTER_KEY=llm-router-secret-key-12345

# Server Port and Host
ROUTER_HOST=0.0.0.0
ROUTER_PORT=8080
LOG_LEVEL=INFO

# ==============================================================================
# 14 FREE PROVIDER API KEYS
# Tip: You can supply COMMA-SEPARATED keys to pool & multiply free rate limits!
# e.g., GEMINI_API_KEYS="key1,key2,key3" -> 3x free rate limits!
# ==============================================================================

# 1. Google AI Studio (Free: 15 RPM, 1M context, Gemini 2.5 Flash / 2.0 Flash / Pro)
# Get free keys at: https://aistudio.google.com/apikey
GEMINI_API_KEYS=

# 2. Groq Cloud (Free: 30 RPM, 300+ tok/s, Llama 3.3 70B, DeepSeek R1 Distill)
# Get free keys at: https://console.groq.com/keys
GROQ_API_KEYS=

# 3. GitHub Models (Free: GPT-4o, GPT-4o-mini, Llama 3.3 70B)
# Get token at: https://github.com/settings/tokens
GITHUB_TOKENS=

